{{- /*
  tools.tsv as a JSON list, for the templates that install tools. One object per row:
  {"name", "group", "version", "method", "package"}. method is the first word of the
  install column when it's "mise" or "apt" (package: the rest), else "".
  Rows of group "desktop" are left out unless .desktop, rows of group "wsl" outside WSL
  (its kernel release names microsoft). A "mise cargo:" row gets no
  method where cargo isn't on PATH: mise would fail to build it.
  Use: {{ range includeTemplate "tools.json" . | fromJson }}…{{ end }}
*/ -}}
{{- $rows := list -}}
{{- $wsl := .chezmoi.kernel.osrelease | lower | contains "microsoft" -}}
{{- range $line := include "dot_config/tools/tools.tsv" | splitList "\n" -}}
{{-   if and $line (not (hasPrefix "#" $line)) -}}
{{-     $f := splitList "\t" $line -}}
{{-     $install := index $f 4 -}}
{{-     $method := "" -}}
{{-     $package := "" -}}
{{-     range $m := list "mise" "apt" -}}
{{-       if hasPrefix (printf "%s " $m) $install -}}
{{-         $method = $m -}}
{{-         $package = trimPrefix (printf "%s " $m) $install -}}
{{-       end -}}
{{-     end -}}
{{-     if and (hasPrefix "cargo:" $package) (not (lookPath "cargo")) -}}
{{-       $method = "" -}}
{{-     end -}}
{{-     $group := index $f 1 -}}
{{-     if and (or (ne $group "desktop") $.desktop) (or (ne $group "wsl") $wsl) -}}
{{-       $rows = append $rows (dict "name" (index $f 0) "group" $group "version" (index $f 2) "method" $method "package" $package) -}}
{{-     end -}}
{{-   end -}}
{{- end -}}
{{- toJson $rows -}}
