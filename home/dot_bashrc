# bash is for scripts, for `bash` typed in fish, and for Claude Code's commands. An
# interactive bash that fish didn't start hands over to fish (below). PATH and the
# login environment live in ~/.profile.

[ -f "$HOME/.cargo/env" ] && . "$HOME/.cargo/env"

# Claude Code runs its commands through this file: give it plain commands, no aliases
if [ -n "$CLAUDECODE" ]; then
	unalias -a
fi

# The rest is for interactive shells only
[[ $- == *i* ]] || return

# Where fish isn't the login shell (a fish from mise lives in ~, so no chsh), an
# interactive bash hands over to fish. Typing `bash` in fish still gives bash.
if [ -z "$CLAUDECODE" ] && [ "${SHELL##*/}" != fish ] &&
	[ "$(cat /proc/$PPID/comm 2>/dev/null)" != fish ] && command -v fish >/dev/null; then
	exec fish
fi

if [ -f /usr/share/bash-completion/bash_completion ]; then
	. /usr/share/bash-completion/bash_completion
fi
bind 'set completion-ignore-case on'
bind 'set show-all-if-ambiguous on'

# History: unlimited, timestamped, one file shared by all sessions
HISTFILE=~/.bash_eternal_history
HISTSIZE=
HISTFILESIZE=
HISTTIMEFORMAT='[%F %T] '
HISTCONTROL=ignoreboth
shopt -s histappend checkwinsize
PROMPT_COMMAND='history -a'

export EDITOR=nvim VISUAL=nvim

# user@host:dir, then a $ that turns red after a failed command
PS1='\[\e[1;32m\]\u@\h\[\e[0m\]:\[\e[1;34m\]\w\[\e[0m\]\[\e[$(( $? ? 31 : 0 ))m\]\$\[\e[0m\] '
