#!/bin/sh
# Print the physical monitors, left to right (then top to bottom):
#   name x y width height mm_width mm_height
# one line per connected and active output, in root-window pixels. The millimetres
# follow the pixel orientation (RandR reports a rotated monitor's mm unrotated).
# Unlike i3-outputs, this ignores virtual RandR monitors such as FILM.
#
# MONITORS_XRANDR=<file> reads xrandr output from a file instead, for tests.

if [ -n "$MONITORS_XRANDR" ]; then cat "$MONITORS_XRANDR"; else xrandr --current; fi |
    awk '
    # "DP-0 connected primary 1200x1920+1200+0 left (normal left ...) 518mm x 324mm"
    $2 == "connected" {
        geo = ($3 == "primary") ? $4 : $3
        if (geo !~ /^[0-9]+x[0-9]+\+[0-9]+\+[0-9]+$/) next     # connected but off
        split(geo, g, /[x+]/)                                  # w h x y
        mw = 0; mh = 0
        for (i = 1; i < NF - 1; i++)
            if ($i ~ /^[0-9]+mm$/ && $(i + 1) == "x" && $(i + 2) ~ /^[0-9]+mm$/) {
                mw = $i + 0; mh = $(i + 2) + 0
            }
        if ((g[1] > g[2]) != (mw > mh)) { t = mw; mw = mh; mh = t }
        print g[3], g[4], $1, g[1], g[2], mw, mh
    }' |
    sort -k1,1n -k2,2n |
    awk '{ print $3, $1, $2, $4, $5, $6, $7 }'
