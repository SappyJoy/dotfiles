#!/bin/bash

# The name of the connection in NetworkManager
# This is usually the same as the .conf filename you imported.
VPN_CONNECTION_NAME="vpnconfig"

# Check if the VPN connection is active in NetworkManager
if nmcli -t -f name,type connection show --active | grep -q "^${VPN_CONNECTION_NAME}:wireguard$"; then
    # Turn OFF VPN
    echo "Stopping VPN via NetworkManager..."
    nmcli connection down "$VPN_CONNECTION_NAME"
    notify-send "VPN" "OFF" -t 1000
else
    # Turn ON VPN
    echo "Starting VPN via NetworkManager..."
    nmcli connection up "$VPN_CONNECTION_NAME"
    notify-send "VPN" "ON" -t 1000
fi
