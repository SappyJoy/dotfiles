#!/bin/sh
# What always goes through WireGuard, read from ~/.config/wireguard/claude-only.list
# (one entry per line, # starts a comment):
#   vpn-hosts ranges   its address ranges (a.b.c.d or a.b.c.d/n)
#   vpn-hosts names    its names
# vpn-setup applies them: ranges as routes, names through dnsmasq.
list=$HOME/.config/wireguard/claude-only.list
range='^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+(/[0-9]+)?$'

entries() { sed -e 's/#.*//' -e 's/[[:space:]]//g' -e '/^$/d' "$list"; }
case ${1:-} in
ranges) entries | grep -E "$range" ;;
names) entries | grep -Ev "$range" ;;
*) echo "usage: vpn-hosts ranges|names" >&2; exit 2 ;;
esac
