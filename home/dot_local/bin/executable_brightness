#!/bin/bash

# Usage: brightness <value (0-100)>
if [ $# -eq 0 ]; then
    echo "Usage: brightness <value (0-100)>"
    exit 1
fi

brightness=$1

# Validate brightness value
if ! [[ "$brightness" =~ ^[0-9]+$ ]] || [ "$brightness" -lt 0 ] || [ "$brightness" -gt 100 ]; then
    echo "Error: Brightness value must be an integer between 0 and 100."
    exit 1
fi

# Adjust brightness for Dell monitors using ddccontrol
for device in /dev/i2c-5 /dev/i2c-7 /dev/i2c-9; do
    echo "Setting brightness to $brightness on $device..."
    if sudo ddccontrol dev:"$device" -r 0x10 -w "$brightness"; then
        echo "Successfully set brightness on $device."
    else
        echo "Failed to set brightness on $device."
    fi
done

