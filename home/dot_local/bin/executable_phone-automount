#!/usr/bin/python3
# Mounts a phone (MTP) as soon as gvfs sees it and points ~/phone at it, so ranger
# and yazi can copy to and from it. GNOME and Xfce mount phones themselves; in i3
# this script does it (i3 autostart). System python: PyGObject is a system package.
import os
import sys

import gi

gi.require_version("Gio", "2.0")
from gi.repository import Gio, GLib

LINK = os.path.expanduser("~/phone")


def mounted(volume, result):
    try:
        volume.mount_finish(result)
    except GLib.Error as e:
        if not e.matches(Gio.io_error_quark(), Gio.IOErrorEnum.ALREADY_MOUNTED):
            print(f"phone-automount: {volume.get_name()}: {e.message}", file=sys.stderr)
            return
    path = volume.get_activation_root().get_path()
    if os.path.islink(LINK):
        os.remove(LINK)
    if path and not os.path.lexists(LINK):
        os.symlink(path, LINK)


def added(monitor, volume):
    root = volume.get_activation_root()
    if root and root.get_uri_scheme() == "mtp":
        volume.mount(Gio.MountMountFlags.NONE, None, None, mounted)


monitor = Gio.VolumeMonitor.get()
monitor.connect("volume-added", added)
for volume in monitor.get_volumes():
    added(monitor, volume)
GLib.MainLoop().run()
