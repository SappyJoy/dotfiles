[user]
	email = stponomarevw@gmail.com
	name = Stepan Ponomarev

# HTTPS auth through gh (`gh auth login` once per machine)
[credential "https://github.com"]
	helper =
	helper = !gh auth git-credential
[credential "https://gist.github.com"]
	helper =
	helper = !gh auth git-credential

[core]
	excludesFile = ~/.gitignore_global
	autocrlf = input
	# Diffs through delta (config below), or plain less where delta is missing
	pager = command -v delta >/dev/null && exec delta || exec less
[interactive]
	diffFilter = command -v delta >/dev/null && exec delta --color-only || exec cat
[init]
	defaultBranch = main
[fetch]
	prune = true                    # forget remote branches deleted upstream
[push]
	autoSetupRemote = true          # the first push of a branch sets its upstream
[help]
	autocorrect = 1                 # run a mistyped command's single guess
[gc]
	auto = 256                      # pack loose objects sooner (default 6700)
[apply]
	whitespace = nowarn
[status]
	submoduleSummary = true
[merge]
	stat = true                     # diffstat after a merge
	log = true                      # merged commits' subjects in the merge message
[rebase]
	stat = true
	autoStash = true

[log]
	date = short
	decorate = short
[format]
	pretty = format:%C(green)%ad%C(reset) %C(yellow)%h%C(auto)%d%C(reset) %s %C(blue)<%an>%C(reset)
[diff]
	algorithm = histogram           # patience's faster successor, git's best
	colorMoved = default            # moved blocks show as moved, not as -/+
	tool = nvimdiff
[delta]
	navigate = true                 # n / N jump between files and hunks
	line-numbers = true
	syntax-theme = ansi             # the terminal's palette, like bat
	file-style = bold blue          # headers without boxes or rules
	file-decoration-style = none
	hunk-header-decoration-style = none
	line-numbers-zero-style = dim   # terminal colors: delta's fixed #444444 is dark on dark
	line-numbers-minus-style = red
	line-numbers-plus-style = green
# delta's light/dark: it can't ask the terminal from inside lazygit, and guesses dark.
# Seeded light once by chezmoi (create_), then theme-switcher rewrites it.
[include]
	path = ~/.config/git/theme.gitconfig

[alias]
	st = status
	ci = commit -v
	co = checkout
	br = branch
	unstage = reset HEAD --
	last = log -1 HEAD
[pull]
	rebase = true
