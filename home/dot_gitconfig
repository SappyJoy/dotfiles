[user]
	email = stponomarevw@gmail.com
	name = Stepan Ponomarev

# HTTPS auth through gh (`gh auth login` once per machine)
[credential "https://github.com"]
	helper =
	helper = !gh auth git-credential
[credential "https://gist.github.com"]
	helper =
	helper = !gh auth git-credential

[core]
	excludesFile = ~/.gitignore_global
	autocrlf = input
[init]
	defaultBranch = main
[fetch]
	prune = true                    # forget remote branches deleted upstream
[push]
	autoSetupRemote = true          # the first push of a branch sets its upstream
[help]
	autocorrect = 1                 # run a mistyped command's single guess
[gc]
	auto = 256                      # pack loose objects sooner (default 6700)
[apply]
	whitespace = nowarn
[status]
	submoduleSummary = true
[merge]
	stat = true                     # diffstat after a merge
	log = true                      # merged commits' subjects in the merge message
[rebase]
	stat = true
	autoStash = true

[log]
	date = short
	decorate = short
[format]
	pretty = format:%C(green)%ad%C(reset) %C(yellow)%h%C(auto)%d%C(reset) %s %C(blue)<%an>%C(reset)
[diff]
	algorithm = histogram           # patience's faster successor, git's best
	colorMoved = default            # moved blocks show as moved, not as -/+
	tool = nvimdiff

[alias]
	st = status
	ci = commit -v
	co = checkout
	br = branch
	unstage = reset HEAD --
	last = log -1 HEAD
