{{- /* Not on arch: arch is where lazy-lock.json is written (:Lazy update, then dots). */ -}}
{{- if ne .chezmoi.osRelease.id "arch" -}}
{{- $inputs := list "lazy-lock.json" "lua/install.lua" "lua/parsers.lua" "lua/plugins/lsp.lua" -}}
{{- $hash := "" -}}
{{- range $inputs }}{{ $hash = print $hash (include (print "dot_config/nvim/" .)) }}{{ end -}}
{{- range (joinPath .chezmoi.sourceDir "dot_config/nvim/lua/lang/*.lua" | glob) }}{{ $hash = print $hash (include .) }}{{ end -}}
#!/bin/sh
# nvim's plugins at lazy-lock.json's commits, then what they download or build
# (lua/install.lua: parsers, mason tools, blink's matcher, orgmode's grammar, the
# Russian spell file), headless, so nvim's first start has nothing left to install.
# After the apt packages (30): parsers need cc, mason's tools unzip and Python's venv.
# chezmoi runs this again when the lock, the installer, the parser or tool lists or a
# language change: {{ $hash | sha256sum }}
# By hand: chezmoi execute-template <"$(chezmoi source-path)/run_onchange_after_40-nvim-plugins.sh.tmpl" | sh
set -u
PATH=$HOME/.local/bin:$HOME/.local/share/mise/shims:$PATH
if ! command -v nvim >/dev/null 2>&1; then
    echo "nvim plugins: no nvim yet, skipped" >&2
    exit 0
fi
log=${XDG_STATE_HOME:-$HOME/.local/state}/nvim/install.log
mkdir -p "${log%/*}"
echo "nvim: installing plugins, parsers and mason tools (log: $log)"
# A plugin's wait loop that never ends would hang chezmoi with no output: stop
# after 45 min (exit 124); the first start then installs what's left.
timeout 45m nvim --headless '+Lazy! restore' '+lua require("install").run()' +qa >"$log" 2>&1
code=$?
grep '^nvim install: ' "$log" | grep -v error
problems=$(grep -iE 'error|fail' "$log")
[ "$code" = 124 ] && problems="$problems${problems:+
}stopped after 45 min"
if [ "$code" != 0 ] || [ -n "$problems" ]; then
    printf '%s\n' "$problems" | sed 's/^/nvim install error: /' >&2
    echo "nvim install error: exit $code, see $log" >&2
fi
exit 0
{{ end -}}
