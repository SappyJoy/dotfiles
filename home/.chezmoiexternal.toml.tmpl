# tmux's status bar (its only plugin, run by tmux.conf; no plugin manager).
# `chezmoi apply -R` (or update) pulls new commits weekly.
[".tmux/plugins/minimal-tmux-status"]
    type = "git-repo"
    url = "https://github.com/niksingh710/minimal-tmux-status"
    refreshPeriod = "168h"

# yazi's piper previewer (yazi.toml: notebook previews). Pinned: a plugin states the
# oldest yazi it runs on (`@since` in main.lua), so bump it together with yazi.
[".config/yazi/plugins/piper.yazi/main.lua"]
    type = "file"
    url = "https://raw.githubusercontent.com/yazi-rs/plugins/f703392df78b5fba5e8f9f1ad0b1cb6d3def9736/piper.yazi/main.lua"
    checksum.sha256 = "4bb1a91a4a9aa0019e7a9bf05aa7ea7070add9d6f42590e1ec7875de978077fc"

{{- /* mise, which installs the tools.tsv rows "mise <tool>". Not on arch (pacman).
       To upgrade: new version and checksums from the release's SHASUMS256.txt. */}}
{{- if ne .chezmoi.osRelease.id "arch" }}
{{-   $version := "2026.9.14" }}
{{-   $sha256 := dict
        "x64" "c79d39e059598b6d16a0987d0e11cb8cdde9a40aab30f2cf39cf9f9390e20f22"
        "arm64" "c2f0ebe89cccc12ac4977b2e491d07c000dd09615dbc6a47f47084a8e8c1f9e9" }}
{{-   $arch := get (dict "amd64" "x64" "arm64" "arm64") .chezmoi.arch }}

# mise {{ $version }}, the static (musl) build
[".local/bin/mise"]
    type = "archive-file"
    url = "https://github.com/jdx/mise/releases/download/v{{ $version }}/mise-v{{ $version }}-linux-{{ $arch }}-musl.tar.gz"
    path = "mise/bin/mise"
    executable = true
    checksum.sha256 = "{{ get $sha256 $arch }}"
{{- end }}
