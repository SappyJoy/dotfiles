# Login environment for sh-compatible shells: bash (via ~/.bash_profile) and ly's
# session script. Keep every line guarded: a failing command here breaks the ly login.

# ~/.local/bin (chezmoi, tools-check, tracked scripts), then the mise shims (tools
# pinned in tools.tsv, non-arch machines), both in front of the system paths.
if [ -d "$HOME/.local/share/mise/shims" ]; then
    case ":$PATH:" in
        *":$HOME/.local/share/mise/shims:"*) ;;
        *) PATH="$HOME/.local/share/mise/shims:$PATH" ;;
    esac
fi
case ":$PATH:" in
    *":$HOME/.local/bin:"*) ;;
    *) PATH="$HOME/.local/bin:$PATH" ;;
esac
export PATH

[ -f "$HOME/.cargo/env" ] && . "$HOME/.cargo/env"

export NVM_DIR="$HOME/.nvm"
[ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"  # This loads nvm

# JetBrains Toolbox scripts, only where Toolbox is installed
if [ -d "$HOME/.local/share/JetBrains/Toolbox/scripts" ]; then
    export PATH="$PATH:$HOME/.local/share/JetBrains/Toolbox/scripts"
fi
