#!/bin/sh
# FILM for herbstluftwm: `film toggle|apply`. herbstluftwm's monitors are just
# rectangles: FILM sets one over the whole screen, off asks X for the physical ones
# (`detect_monitors`, through Xinerama). The choice is kept for the next login;
# the panels restart for the new monitors.
state=${XDG_STATE_HOME:-$HOME/.local/state}/wm-tour/film
saved=$(cat "$state" 2>/dev/null)

case $1 in
    toggle)
        if [ "$saved" = off ]; then mode=on; else mode=off; fi
        mkdir -p "${state%/*}"
        echo "$mode" >"$state"
        ;;
    apply) if [ "$saved" = off ]; then mode=off; else mode=on; fi ;;
    *) echo "usage: film toggle|apply" >&2; exit 2 ;;
esac

if [ "$mode" = on ]; then
    herbstclient set_monitors "$(xdpyinfo | awk '/dimensions:/ { print $2 }')+0+0"
else
    herbstclient detect_monitors
fi
[ "$1" = apply ] || /etc/xdg/herbstluftwm/restartpanels.sh
