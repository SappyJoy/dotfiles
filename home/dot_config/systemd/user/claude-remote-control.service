# Lets the phone start Claude sessions here while no terminal session is open (M62).
# OFF until "Require trusted devices" is on at claude.ai: anyone signed in to the account
# could otherwise start sessions that run as you. Not enabled by chezmoi; start it with
#   systemctl --user enable --now claude-remote-control
# Stop: systemctl --user disable --now claude-remote-control
# Default permission mode (prompts show on the phone); each session gets its own worktree
# of the repo below. Idle it costs no tokens.
[Unit]
Description=Claude Code Remote Control server (sessions started from the phone)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/src/personal/claude/toolkit
ExecStart=/usr/sbin/claude remote-control --name phone --spawn worktree --permission-mode default
Restart=always
RestartSec=30

[Install]
WantedBy=default.target
