# sxhkd: the keys for bspwm, which has none of its own. Each key runs a command,
# mostly `bspc`. Super+Escape reloads this file. Arrows rather than h/j/k/l.

# --- The tour's shared keys -------------------------------------------------

# Terminal, launcher
super + t
	kitty
super + d
	dmenu_run

# Close, fullscreen, FILM ↔ three monitors
super + shift + q
	bspc node -c
super + f
	bspc node -t ~fullscreen
super + shift + f
	~/.config/bspwm/film toggle

# Focus, swap
super + {Left,Down,Up,Right}
	bspc node -f {west,south,north,east}
super + shift + {Left,Down,Up,Right}
	bspc node -s {west,south,north,east}

# Desktops 1-10 by name, wherever they are on the desk
super + {1-9,0}
	bspc desktop -f {1-9,10}
super + shift + {1-9,0}
	bspc node -d {1-9,10}

# Restart bspwm, reload these keys, log out
super + shift + r
	bspc wm -r
super + Escape
	pkill -USR1 -x sxhkd
super + shift + u
	bspc quit

# Volume
XF86Audio{RaiseVolume,LowerVolume}
	pactl set-sink-volume @DEFAULT_SINK@ {+5%,-5%}
XF86AudioMute
	pactl set-sink-mute @DEFAULT_SINK@ toggle

# --- bspwm's own ------------------------------------------------------------

# Preselect where the next window goes (a colored area shows it), cancel
super + ctrl + {Left,Down,Up,Right}
	bspc node -p {west,south,north,east}
super + ctrl + space
	bspc node -p cancel

# Grow or shrink the focused window
super + alt + {Left,Down,Up,Right}
	bspc node -z {left -40 0,bottom 0 40,top 0 -40,right 40 0}
super + alt + shift + {Left,Down,Up,Right}
	bspc node -z {right -40 0,top 0 40,bottom 0 -40,left 40 0}

# The tree: rotate it, balance it, swap with the biggest window
super + r
	bspc node @/ -R 90
super + b
	bspc node @/ -B
super + g
	bspc node -s biggest.window.local

# Window state: tiled, pseudo-tiled (keeps its own size), floating; monocle
super + {s,p,shift + space}
	bspc node -t ~{tiled,pseudo_tiled,floating}
super + m
	bspc desktop -l next

# Focus the parent, the last window, the last desktop, the previous or next
# desktop on this monitor
super + a
	bspc node -f @parent
super + Tab
	bspc node -f last
super + grave
	bspc desktop -f last
super + bracket{left,right}
	bspc desktop -f {prev,next}.local
