# -------------------------------------------------------------------
# APPS
# -------------------------------------------------------------------
# Terminal
super + Return
	kitty

# Rofi Launcher
super + d
	rofi -show drun

# Rofi Clipboard (greenclip)
super + c
	rofi -modi "clipboard:greenclip print" -show clipboard

# Lock screen
ctrl + super + l
	~/.config/i3/lock

# Screenshot
Print
	flameshot gui

# -------------------------------------------------------------------
# BSPWM & WINDOW MANAGEMENT
# -------------------------------------------------------------------
# Quit/restart bspwm
super + alt + {q,r}
	bspc {quit,wm -r}

# Close window
super + shift + q
	bspc node -c

# Fullscreen
super + f
	bspc node -t \~fullscreen

# Toggle floating
super + shift + space
	bspc node -t \~floating

# Set the window state
super + {t,s}
	bspc node -t {tiled,pseudo_tiled}

# -------------------------------------------------------------------
# FOCUS & SWAP
# -------------------------------------------------------------------
# Focus node
super + {h,j,k,l}
	bspc node -f {west,south,north,east}

# Swap node
super + shift + {h,j,k,l}
	bspc node -s {west,south,north,east}

# Focus monitor
super + {_,shift + }bracket{left,right}
	bspc monitor -f {prev,next}

# -------------------------------------------------------------------
# PRESELECTION & RESIZE
# -------------------------------------------------------------------
# Preselect the direction
super + ctrl + {h,j,k,l}
	bspc node -p {west,south,north,east}

# Preselect the ratio
super + ctrl + {1-9}
	bspc node -o 0.{1-9}

# Cancel the preselection
super + ctrl + space
	bspc node -p cancel

# Resize
super + alt + {h,j,k,l}
	bspc node -r {-20 0,0 20,0 -20,20 0}

# -------------------------------------------------------------------
# WORKSPACES (Desktops in bspwm)
# -------------------------------------------------------------------
# Switch to desktop
super + {1-9,0}
	bspc desktop -f '^{1-9,10}'

# Send node to desktop
super + shift + {1-9,0}
	bspc node -d '^{1-9,10}'

# -------------------------------------------------------------------
# YOUR CUSTOM SCRIPTS
# -------------------------------------------------------------------
# Toggle between film and work mode
super + shift + f
    ~/.local/bin/film_mode.sh

super + shift + w
    ~/.local/bin/work_mode.sh

# Brightness control
super + {Prior,Next}
	brightnessctl set {+10%,10%-}

# Volume control (using pactl)
XF86Audio{RaiseVolume,LowerVolume,Mute}
	pactl set-sink-volume @DEFAULT_SINK@ {+5%,-5%,toggle}
