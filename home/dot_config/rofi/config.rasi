/* rofi 2.0: only what differs from rofi's defaults (man rofi, man rofi-theme). */

configuration {
    modes: "drun,run,window";
    font: "Hack Nerd Font 12";
    show-icons: true;
    terminal: "kitty";
    /* apps by name only, without the generic name (Web Browser) */
    drun-display-format: "{name}";
}

/* Start from an empty theme, not rofi's default one */
@theme "/dev/null"

/* Ayu light; in dark mode theme-switcher writes colors.rasi with Ayu Mirage */
* {
    bg: #FAFAFA;
    bg-alt: #F3F4F5;
    fg: #5C6A72;
    accent: #FA8D3E;

    background-color: @bg;
    text-color: @fg;
}
?import "colors"

window {
    width: 600px;
    border: 2px;
    border-color: @accent;
    padding: 16;
}

mainbox {
    children: [inputbar, listview];
    spacing: 12px;
}

inputbar {
    children: [prompt, entry];
    border-radius: 5px;
    padding: 2px 8px;
    background-color: @bg-alt;
}

prompt {
    text-color: @accent;
}

listview {
    lines: 8;
    cycle: true;
    dynamic: true;
}

element {
    padding: 8px;
    border-radius: 5px;
}

element-text, element-icon {
    vertical-align: 0.5;
}

element selected {
    background-color: @accent;
    text-color: @bg;
}
