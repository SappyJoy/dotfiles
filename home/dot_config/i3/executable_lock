#!/bin/bash
# Lock the screen: i3lock-color with the screen blurred, a clock and the keyboard
# layout, in Ayu's orange. Plain i3lock (apt's) has none of these options: it gets a
# dark screen instead. Extra arguments go to i3lock (xss-lock passes --nofork).
# dunst stays paused while locked, since it draws new notifications on top of the
# lock screen: they queue and show after unlocking.

if i3lock --version 2>&1 | grep -q 'Raymond Li'; then
    BLANK='#00000000'
    CLEAR='#ffffff22'
    DEFAULT='#FA8D3FE6'
    TEXT='#FA8D3FE6'
    WRONG='#FF7383bb'
    VERIFYING='#399EE6E6'

    set -- \
    --insidever-color=$CLEAR     \
    --ringver-color=$VERIFYING   \
    \
    --insidewrong-color=$CLEAR   \
    --ringwrong-color=$WRONG     \
    \
    --inside-color=$BLANK        \
    --ring-color=$DEFAULT        \
    --line-color=$BLANK          \
    --separator-color=$DEFAULT   \
    \
    --verif-color=$TEXT          \
    --wrong-color=$TEXT          \
    --time-color=$TEXT           \
    --date-color=$TEXT           \
    --layout-color=$TEXT         \
    --keyhl-color=$WRONG         \
    --bshl-color=$WRONG          \
    \
    --screen 1                   \
    --blur 9                     \
    --clock                      \
    --indicator                  \
    --time-str="%H:%M:%S"        \
    --date-str="%A, %Y-%m-%d"    \
    --keylayout 1                \
    "$@"
else
    set -- --color=0f1419 "$@"
fi

# Without dunst, just lock. Otherwise pause it, and restore its pause level (do
# not disturb may be on) once i3lock exits.
level=$(dunstctl get-pause-level 2>/dev/null) || exec i3lock "$@"
dunstctl set-paused true

i3lock --nofork "$@" &
locker=$!
# xss-lock ends a lock with SIGTERM (e.g. `loginctl unlock-session`): pass it on
trap 'kill "$locker" 2>/dev/null' TERM INT HUP
# Before a suspend, xss-lock hands over its sleep lock (an fd); the suspend goes
# on once every copy is closed. i3lock closes its copy when the screen is locked;
# this shell closes its own now.
if [[ -n ${XSS_SLEEP_LOCK_FD:-} ]]; then exec {XSS_SLEEP_LOCK_FD}<&-; fi
wait "$locker"

dunstctl set-pause-level "$level"
