#!/bin/sh
# bspwm: binary space partitioning. Each new window splits the focused one in two,
# on its longer side or where Super+Ctrl+arrow preselected. bspwm only manages
# windows: its keys are sxhkd's (sxhkdrc), and it has no bar.
# `bspc config …` changes a setting live; Super+Shift+r restarts bspwm, which keeps
# the windows and runs this file again ($1 = the number of restarts).

# Once per login: keys, notifications (xfce4-notifyd), key repeat, root cursor
if [ "${1:-0}" -eq 0 ]; then
    sxhkd &
    /usr/lib/xfce4/notifyd/xfce4-notifyd &
    xset r rate 200 30
    xsetroot -cursor_name left_ptr
fi

# Desktops 1-10, all on FILM or spread over the three monitors (Super+Shift+f
# switches; the choice is kept for the next login)
if [ "${1:-0}" -eq 0 ]; then
    "$HOME/.config/bspwm/film" start
fi

# Settings from bspwm's example config
bspc config border_width        2
bspc config window_gap         12
bspc config split_ratio          0.52
bspc config borderless_monocle   true
bspc config gapless_monocle      true
