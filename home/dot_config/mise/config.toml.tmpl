{{- /* Global mise config. arch gets its tools from pacman, so only the settings; the
       other machines also get the tools.tsv rows "mise <tool>". */ -}}
# Generated by chezmoi: the settings from home/dot_config/mise/config.toml.tmpl, the
# tool pins from ~/.config/tools/tools.tsv. Edit those, not this file.

[settings]
# Per-project versions from the files these tools already read, e.g. Quartz's
# .node-version. Not python: uv reads .python-version.
idiomatic_version_file_enable_tools = ["node", "java"]
{{- if ne .chezmoi.osRelease.id "arch" }}

# `chezmoi apply` runs `mise install` whenever the pins change.
[tools]
{{- includeTemplate "mise-tools.toml" . }}
{{- end }}
