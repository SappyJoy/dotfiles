{{- /* The tools.tsv rows "mise <tool>", pinned to the arch versions. */ -}}
# Generated by chezmoi from ~/.config/tools/tools.tsv: edit that list, not this file.
# `chezmoi apply` runs `mise install` whenever the pins change.
[tools]
{{- range includeTemplate "tools.json" . | fromJson }}
{{-   if eq .method "mise" }}
"{{ .package }}" = "{{ if eq .version "-" }}latest{{ else }}{{ .version }}{{ end }}"
{{-   end }}
{{- end }}
