-- xmobar: xmonad's companion bar, started by the tour's xmonad. Left: workspaces
-- and the window title, from xmonad; right: the date. With FILM, xmonad passes a
-- position that spans the desk.
Config { font = "Monospace 10"
       , bgColor = "black"
       , fgColor = "grey"
       , position = TopH 22
       , commands = [ Run XMonadLog
                    , Run Date "%a %Y-%m-%d %H:%M" "date" 100
                    ]
       , sepChar = "%"
       , alignSep = "}{"
       , template = " %XMonadLog% }{ %date% "
       }
