{{- /* chezmoi:modify-template */ -}}
{{- /* Claude Code's settings.json, shared by both accounts (~/.claude-personal links
       to it). Claude Code rewrites it (/model, /theme), so the machine owns the file;
       this sets the keys every machine shares and leaves the rest alone: theme (the
       work PCs' terminal is light) and preferredNotifChannel (kitty on arch). */ -}}
{{- $s := dict }}
{{- if .chezmoi.stdin }}{{ $s = fromJson .chezmoi.stdin }}{{ end }}
{{- $s = setValueAtPath "model" "opus[1m]" $s }}
{{- $s = setValueAtPath "modelSettings" (dict
      "claude-opus-5-5" (dict "effortLevel" "xhigh")
      "claude-fable-5-1" (dict "effortLevel" "high")) $s }}
{{- $s = setValueAtPath "enableWorkflows" false $s }}
{{- $s = setValueAtPath "agentPushNotifEnabled" true $s }}
{{- /* Compact at 300k, not at about 967k (Opus 1M's default): long autonomous runs
       grew sessions to 460k, and every reply re-reads the whole context. */ -}}
{{- $s = setValueAtPath "autoCompactWindow" 300000 $s }}
{{- $s = setValueAtPath "statusLine" (dict
      "type" "command"
      "command" "bash ~/.claude/statusline-command.sh") $s }}
{{- /* A claude started by hand connects to the nvim (claudecode.nvim) that has its
       folder open, when there's exactly one; otherwise /ide. */ -}}
{{- $s = setValueAtPath "env.CLAUDE_CODE_AUTO_CONNECT_IDE" "1" $s }}
{{- /* Desktops: polybar's claude glyph spins while a session works; busy-hook.sh marks
       it (see there). `|| :` keeps the exit code 0. These hooks own their events. */ -}}
{{- if .desktop }}
{{-   $on := list (dict "hooks" (list (dict "type" "command" "command" "sh ~/.claude/busy-hook.sh on || :" "timeout" 5))) }}
{{-   $off := list (dict "hooks" (list (dict "type" "command" "command" "sh ~/.claude/busy-hook.sh off || :" "timeout" 5))) }}
{{-   $s = setValueAtPath "hooks.UserPromptSubmit" $on $s }}
{{-   $s = setValueAtPath "hooks.PostToolUse" $on $s }}
{{-   $s = setValueAtPath "hooks.Stop" $off $s }}
{{-   $s = setValueAtPath "hooks.StopFailure" $off $s }}
{{-   $s = setValueAtPath "hooks.SessionEnd" $off $s }}
{{-   $s = setValueAtPath "hooks.Notification" (list (dict
        "matcher" "permission_prompt|idle_prompt|elicitation_dialog|agent_needs_input"
        "hooks" (index $off 0).hooks)) $s }}
{{- end }}
{{- toPrettyJson "  " $s -}}
